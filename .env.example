# g2bmaster-AI 설정.
# 값이 없으면 기본값을 쓰고, 형식이 틀리면 기동을 거부한다(src/config.ts).
# 비밀값은 절대 커밋하지 않는다 — 이 파일에는 자리표시자만 둔다.

# --- 서버 ---
PORT=8100
HOST=0.0.0.0
LOG_LEVEL=info

# --- LLM 상한 (Principles §4.3: 상한은 스스로 건다) ---
# 동시 LLM 호출 수.
LLM_MAX_CONCURRENCY=4
# 게이트웨이가 LLM 한 번에 허용하는 최대 시간.
# 요청 deadlineMs 와 min 을 취하므로 이 값은 절대 상한일 뿐이다.
LLM_PER_CALL_CAP_MS=60000

# --- 클램프 ---
# 모델 컨텍스트 창(토큰). lms.js 의 자동 탐지를 붙이기 전까지는 설정으로 받는다.
CONTEXT_WINDOW_TOKENS=32768

# --- M1+ 에서 채운다 ---
# LM Studio / OpenAI 호환 엔드포인트. 쉼표로 여러 개.
# LLM_ENDPOINTS=http://127.0.0.1:1234/v1
# LLM_API_KEY=
# korean-law-mcp 주소.
# LAW_MCP_BASE_URL=http://127.0.0.1:8000
