# g2bmaster-AI — 나라장터 입찰정보 추론 계층

# 백엔드의 AI_BASE_URL 기본값이 http://localhost:8000 이다.
HOST=127.0.0.1
PORT=8000

# ─── LLM ─────────────────────────────────────────────────────────────────────
# LM Studio 등 OpenAI 호환 서버 주소
LMS_BASE=http://localhost:1234
# 외부 API 를 쓸 때만 필요(로컬 LM Studio 는 키 없음)
LLM_API_KEY=
# LM Studio 는 로드된 모델을 자동 추적한다. 외부 API 는 여기 모델명을 지정한다.
LMS_MODEL=
LLM_TEMPERATURE=0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=8192
LLM_CONTEXT_WINDOW=32768

# GPU 여러 대에 분산하려면: "http://gpu1:1234@2,http://gpu2:1234@1" (@뒤는 동시 처리 용량)
# 비워 두면 LMS_BASE 한 대를 용량 1 로 쓴다.
LLM_WORKERS=

# 설치된 모델을 디스크에서 찾을 위치 (LM Studio 서버가 꺼져 있을 때 목록 표시용)
# LMS_MODELS_DIR=

# ─── 가격 웹검색 (아직 미이식) ───────────────────────────────────────────────
SEARCH_PROVIDER=studyweb
STUDYWEB_URL=http://localhost:8787
STUDYWEB_API_KEY=
# SEARCH_PLATFORMS=
# PRICE_PROMPT=

# ─── 호출자 인증 ─────────────────────────────────────────────────────────────
# 설정하면 X-Internal-Secret 또는 Authorization: Bearer 를 요구한다.
# 원본 module_server.py 는 INTERNAL_SECRET 을 썼다 — 둘 다 받는다.
AI_SERVICE_SECRET=

# 설정 파일(data/ai-config.json) 위치. 서버리스면 /tmp 로 둔다.
# ATTACHMENT_CACHE_DIR=
