# g2bmaster-AI — 나라장터 입찰정보 추론 계층

# 백엔드의 AI_BASE_URL 기본값이 http://localhost:8000 이다.
HOST=127.0.0.1
PORT=8000

# ─── LLM ─────────────────────────────────────────────────────────────────────
# LM Studio 등 OpenAI 호환 서버 주소
LMS_BASE=http://localhost:1234
# 외부 API 를 쓸 때만 필요(로컬 LM Studio 는 키 없음)
LLM_API_KEY=
# LM Studio 는 로드된 모델을 자동 추적한다. 외부 API 는 여기 모델명을 지정한다.
LMS_MODEL=
LLM_TEMPERATURE=0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=40960
LLM_CONTEXT_WINDOW=40960

# LLM 호출 하나의 데드라인(초). 이 순서를 지켜야 한다:
#   이 값  <  백엔드 AI_TIMEOUT_MS(기본 120초)  <  백엔드 ANALYSIS_LEASE_MS(기본 300초)
# 뒤집히면 백엔드가 먼저 포기한 작업을 다른 워커가 다시 집어 같은 공고를 두 번 추론한다.
# 늘릴 때는 백엔드의 두 값도 함께 올릴 것.
LLM_TIMEOUT_SECONDS=100

# GPU 여러 대에 분산한다. 콤마로 엔드포인트를 나열하고 "@뒤"는 그 엔드포인트의 동시 처리 용량이다.
# 비워 두면 LMS_BASE 한 대를 용량 1 로 쓴다.
#
# 예) RTX 4090 4장 — LM Studio 를 GPU 마다 다른 포트로 띄우고(각각 한 GPU 에 고정) 네 대를 나열:
#   LLM_WORKERS=http://localhost:1234@1,http://localhost:1235@1,http://localhost:1236@1,http://localhost:1237@1
# 한 대가 큰 모델을 여러 요청 동시에 처리할 수 있으면 용량을 올린다(@2 등).
#
# 배치 작업(공고 분류·부품 추출)은 요청을 gather 로 한꺼번에 던지고, 워커 풀이 여유율 기준으로
# 네 대에 흩뿌린다 — 순차로 돌면 네 대여도 한 대만 일하므로 반드시 이 설정으로 나눠야 한다.
# 한 대가 죽으면 쿨다운 후 다른 대로 페일오버한다(처리량이 0 으로 떨어지지 않는다).
LLM_WORKERS=

# 배치가 한 번에 흘려보낼 요청 수. 비우면 건강한 워커의 총 용량(4090 4장@1이면 4).
# 그보다 크게 잡아도 워커 풀이 용량에서 막으므로 처리량은 안 늘고 대기자만 쌓인다.
# LLM_BATCH_CONCURRENCY=

# 재시도 가능 실패 후 그 카드를 쉬게 하는 시간(ms).
# LLM_WORKER_COOLDOWN_MS=30000

# 읽기 타임아웃(응답 대기 중 끊김)을 다른 카드로 재시도할지. 기본 false.
# LM Studio 는 클라이언트가 끊겨도 생성을 계속할 수 있어, 재시도하면 같은 프롬프트가 두 장에서
# 돈다(비용 2배). 백엔드 작업 큐가 이미 재시도를 갖고 있으므로 AI 안에서는 끄는 게 맞다.
# 연결 실패(ConnectError 등, 생성 시작 전)는 이 설정과 무관하게 항상 재시도한다.
# LLM_RETRY_ON_TIMEOUT=false

# 설치된 모델을 디스크에서 찾을 위치 (LM Studio 서버가 꺼져 있을 때 목록 표시용)
# LMS_MODELS_DIR=

# ─── 가격 웹검색 (아직 미이식) ───────────────────────────────────────────────
SEARCH_PROVIDER=studyweb
STUDYWEB_URL=http://localhost:8787
STUDYWEB_API_KEY=
# SEARCH_PLATFORMS=
# PRICE_PROMPT=

# ─── 호출자 인증 ─────────────────────────────────────────────────────────────
# 설정하면 X-Internal-Secret 또는 Authorization: Bearer 를 요구한다.
# 원본 module_server.py 는 INTERNAL_SECRET 을 썼다 — 둘 다 받는다.
#
# 주의: 설정해도 /docs·/openapi.json·/redoc 은 통과한다(app/main.py OPEN_PATHS).
#       외부에 노출되는 환경이라면 그 경로들을 꺼야 한다 — docs/decisions.md F-6.
AI_SERVICE_SECRET=

# 설정 파일(data/ai-config.json) 위치. 서버리스면 /tmp 로 둔다.
# ATTACHMENT_CACHE_DIR=
